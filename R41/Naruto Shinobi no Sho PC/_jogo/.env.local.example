# R41 final — Cloudflare Pages + Cloudflare Workers/Durable Objects + MongoDB Atlas.
# Este arquivo é apenas referência. O PowerShell automático cria/configura os segredos
# diretamente no Cloudflare; não copie senhas ou tokens para o repositório.
MONGODB_DB=naruto_shinobi_r41
MONGODB_URI=
AUTH_SECRET=
LEON_PRIVATE_CODE=
ALLOWED_ORIGINS=https://kaalflash12.github.io
NARUTO_R41_API_ORIGIN=
